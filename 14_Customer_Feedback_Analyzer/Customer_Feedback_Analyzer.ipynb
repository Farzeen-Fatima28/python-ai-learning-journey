   "source": [
    "import sqlite3\n",
    "\n",
    "conn = sqlite3.connect(\"feedback.db\")\n",
    "cursor = conn.cursor()\n",
    "cursor.execute(\"DELETE FROM reviews\")\n",
    "conn.commit()\n",
    "conn.close()\n",
    "print(\"All reviews cleared.\")"
   ]
